TARGET          = colditz
OBJS            = conf.o dictionary.o game.o graphics.o getopt.o iniparser.o low-level.o main.o md5.o soundplayer.o agent_api.o osx/audio_backend.o

CC              = gcc
LD              = gcc

GLEW_PREFIX     = $(shell brew --prefix glew 2>/dev/null || echo /usr/local)

# Uses the native (deprecated, but still functional) GLUT and OpenGL frameworks
# instead of freeglut/X11, as XQuartz GLX is broken on macOS 26 "Tahoe" and later.
CFLAGS         += -I. -I$(GLEW_PREFIX)/include -O3 -Wall -Wshadow -Wundef -Wunused -Wno-deprecated-declarations
CXXFLAGS       += $(CFLAGS) -fno-exceptions -fno-rtti

LIBS           += -lGLEW -framework GLUT -framework OpenGL -framework CoreFoundation -framework IOKit -framework CoreAudio -framework AudioUnit
LIBDIRS        += -L$(GLEW_PREFIX)/lib

LDFLAGS        += $(LIBDIRS) $(LIBS)

.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

all: $(TARGET)

$(TARGET): $(OBJS)
	$(LD) -o $(TARGET) $(OBJS) $(LDFLAGS)

clean:
	$(RM) $(OBJS) $(TARGET)

superclean: clean

release: all
	cp colditz "Colditz Escape"
